# Gemini API key (https://aistudio.google.com/apikey) — used by scripts/label.py
GOOGLE_API_KEY=
# Optional: teacher model override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=
# Optional: reasoning effort (none|minimal|low|medium|high; default: low)
# GEMINI_THINKING_LEVEL=

# Hugging Face token with write access — used to publish model, dataset and Space
HF_TOKEN=

# Optional: Kaggle credentials (the Olist dataset is public and downloads without them)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
